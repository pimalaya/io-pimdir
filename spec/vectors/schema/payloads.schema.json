{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pimalaya/pimdir/vectors/schema/payloads.schema.json",
  "$comment": "SPDX-License-Identifier: MIT OR Apache-2.0",
  "title": "Queue payloads (STORAGE.md section 15.3), vectors/payloads.json",
  "type": "object",
  "required": ["v", "cases"],
  "additionalProperties": false,
  "properties": {
    "v": { "const": 2 },
    "note": { "type": "string" },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "outcome", "payload"],
        "additionalProperties": false,
        "properties": {
          "action": { "type": "string", "minLength": 1 },
          "outcome": { "enum": ["valid", "malformed", "unknown"] },
          "payload": { "type": "object" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
