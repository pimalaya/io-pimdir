    "collections": [
      { "id": "INBOX", "account": null, "kind": "message/rfc822", "conflict": "manual" },
      { "id": "Archive", "account": null, "kind": "message/rfc822", "conflict": "manual" }
    ],
    "objects": {
      "m1": { "body": "fixtures/mail-basic.eml" }
    },
    "items": [
      { "collection": "INBOX", "link_id": "basic-1@example.org", "seq": 1, "flags": ["\\Seen"], "object": "m1", "level": 2, "deleted": 1 },
      { "collection": "Archive", "link_id": "basic-1@example.org", "seq": 1, "flags": ["\\Seen"], "object": "m1", "level": 2, "deleted": 0 }
    ],
    "bindings": [
      { "collection": "INBOX", "link_id": "basic-1@example.org", "source": "imap", "handle": "10", "base_flags": ["\\Seen"], "base_object": "m1", "base_revision": null, "base_present": 1 },
      { "collection": "Archive", "link_id": "basic-1@example.org", "source": "imap", "handle": "\u0001basic-1@example.org", "base_flags": null, "base_object": null, "base_revision": null, "base_present": 0 }
    ],
    "sources": [
      { "collection": "INBOX", "source": "imap", "checkpoint": "c0" },
      { "collection": "Archive", "source": "imap", "checkpoint": "a0" }
    ]
  },
  "run": {
    "verb": "sync",
    "collection": "INBOX",
    "source": "imap",
    "options": {
