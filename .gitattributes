# The fixtures are byte-exact: an object is named by the hash of its raw bytes
# (pimdir STORAGE §5), and mail and calendar bodies are CRLF. Without this git
# normalises them under core.autocrlf and no body a clone holds matches its
# name.
tests/fixtures/** -text
# The vendored vectors are pimdir's byte for byte (spec/REVISION): their
# fixtures CRLF, the rest LF, and spec_drift compares them with the
# specification's own bytes, so no checkout converts their line ends.
spec/vectors/** -text
spec/payloads/** -text
