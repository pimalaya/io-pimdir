{
  "$defs": {
    "CoverageRow": {
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "cut": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "horizonLeft": {
          "type": "boolean"
        },
        "local": {
          "$ref": "#/$defs/LocalRow"
        },
        "remote": {
          "$ref": "#/$defs/RemoteRow"
        },
        "temporal": {
          "$ref": "#/$defs/TemporalRow"
        },
        "zoneDiffers": {
          "type": "boolean"
        }
      },
      "required": [
        "complete",
        "local",
        "temporal",
        "remote",
        "horizonLeft",
        "cut",
        "zoneDiffers"
      ],
      "type": "object"
    },
    "LocalRow": {
      "properties": {
        "behind": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "kinds": {
          "additionalProperties": {
            "$ref": "#/$defs/UnreadRow"
          },
          "type": "object"
        },
        "reads": {
          "$ref": "#/$defs/ReadsRow"
        },
        "unindexed": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "kinds",
        "reads",
        "unindexed",
        "behind"
      ],
      "type": "object"
    },
    "ReadsRow": {
      "properties": {
        "content": {
          "type": "boolean"
        },
        "kinds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "mark": {
          "type": "boolean"
        }
      },
      "required": [
        "kinds",
        "content",
        "mark"
      ],
      "type": "object"
    },
    "RemoteRow": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "local-only",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "exhaustive": {
              "type": "boolean"
            },
            "kind": {
              "const": "augmented",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "exhaustive"
          ],
          "type": "object"
        }
      ]
    },
    "TagHitRow": {
      "properties": {
        "account": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string"
        },
        "placements": {
          "items": {
            "$ref": "#/$defs/TagPlacementRow"
          },
          "type": "array"
        },
        "seq": {
          "format": "int64",
          "type": "integer"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "account",
        "seq",
        "kind",
        "title",
        "placements"
      ],
      "type": "object"
    },
    "TagPlacementRow": {
      "properties": {
        "collection": {
          "type": "string"
        },
        "flags": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "handle": {
          "type": [
            "string",
            "null"
          ]
        },
        "linkId": {
          "type": "string"
        },
        "missing": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "next": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "row": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/TagStatus"
        },
        "syncs": {
          "type": "boolean"
        }
      },
      "required": [
        "collection",
        "linkId",
        "flags",
        "next",
        "status",
        "source",
        "sources",
        "syncs",
        "missing",
        "row",
        "handle"
      ],
      "type": "object"
    },
    "TagStatus": {
      "oneOf": [
        {
          "const": "planned",
          "type": "string"
        },
        {
          "const": "unchanged",
          "type": "string"
        },
        {
          "const": "unknown-flags",
          "type": "string"
        },
        {
          "const": "ambiguous-source",
          "type": "string"
        },
        {
          "const": "unsynced",
          "type": "string"
        },
        {
          "const": "unsupported",
          "type": "string"
        },
        {
          "const": "applied",
          "type": "string"
        },
        {
          "const": "queued",
          "type": "string"
        },
        {
          "const": "refused",
          "type": "string"
        }
      ]
    },
    "TemporalRow": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "full",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "filling": {
              "type": "boolean"
            },
            "kind": {
              "const": "bounded",
              "type": "string"
            },
            "since": {
              "type": [
                "string",
                "null"
              ]
            },
            "until": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "since",
            "until",
            "filling"
          ],
          "type": "object"
        }
      ]
    },
    "UnreadRow": {
      "properties": {
        "bodiless": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "encrypted": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "missing": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "unparseable": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "bodiless",
        "missing",
        "unparseable",
        "encrypted"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "add": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "coverage": {
      "$ref": "#/$defs/CoverageRow"
    },
    "dryRun": {
      "type": "boolean"
    },
    "hits": {
      "items": {
        "$ref": "#/$defs/TagHitRow"
      },
      "type": "array"
    },
    "query": {
      "type": "string"
    },
    "remove": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "query",
    "dryRun",
    "add",
    "remove",
    "hits",
    "coverage"
  ],
  "title": "TagOutput",
  "type": "object"
}
