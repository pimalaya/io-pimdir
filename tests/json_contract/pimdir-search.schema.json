{
  "$defs": {
    "CoverageRow": {
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "cut": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "horizonLeft": {
          "type": "boolean"
        },
        "local": {
          "$ref": "#/$defs/LocalRow"
        },
        "remote": {
          "$ref": "#/$defs/RemoteRow"
        },
        "temporal": {
          "$ref": "#/$defs/TemporalRow"
        },
        "zoneDiffers": {
          "type": "boolean"
        }
      },
      "required": [
        "complete",
        "local",
        "temporal",
        "remote",
        "horizonLeft",
        "cut",
        "zoneDiffers"
      ],
      "type": "object"
    },
    "HitRow": {
      "properties": {
        "account": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string"
        },
        "matched": {
          "anyOf": [
            {
              "$ref": "#/$defs/Matched"
            },
            {
              "type": "null"
            }
          ]
        },
        "placements": {
          "items": {
            "$ref": "#/$defs/PlacementRow"
          },
          "type": "array"
        },
        "seq": {
          "format": "int64",
          "type": "integer"
        },
        "snippet": {
          "type": [
            "string",
            "null"
          ]
        },
        "sortKey": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "account",
        "seq",
        "kind",
        "title",
        "sortKey",
        "matched",
        "snippet",
        "placements"
      ],
      "type": "object"
    },
    "LocalRow": {
      "properties": {
        "behind": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "kinds": {
          "additionalProperties": {
            "$ref": "#/$defs/UnreadRow"
          },
          "type": "object"
        },
        "reads": {
          "$ref": "#/$defs/ReadsRow"
        },
        "unindexed": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "kinds",
        "reads",
        "unindexed",
        "behind"
      ],
      "type": "object"
    },
    "Matched": {
      "oneOf": [
        {
          "const": "body",
          "type": "string"
        },
        {
          "const": "summary",
          "type": "string"
        }
      ]
    },
    "PlacementRow": {
      "properties": {
        "collection": {
          "type": "string"
        },
        "flags": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "level": {
          "type": "string"
        },
        "linkId": {
          "type": "string"
        },
        "object": {
          "type": [
            "string",
            "null"
          ]
        },
        "sortKey": {
          "type": "string"
        }
      },
      "required": [
        "collection",
        "linkId",
        "flags",
        "object",
        "level",
        "sortKey"
      ],
      "type": "object"
    },
    "ReadsRow": {
      "properties": {
        "content": {
          "type": "boolean"
        },
        "kinds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "mark": {
          "type": "boolean"
        }
      },
      "required": [
        "kinds",
        "content",
        "mark"
      ],
      "type": "object"
    },
    "RemoteRow": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "local-only",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "exhaustive": {
              "type": "boolean"
            },
            "kind": {
              "const": "augmented",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "exhaustive"
          ],
          "type": "object"
        }
      ]
    },
    "SearchOutput": {
      "properties": {
        "coverage": {
          "$ref": "#/$defs/CoverageRow"
        },
        "hits": {
          "items": {
            "$ref": "#/$defs/HitRow"
          },
          "type": "array"
        },
        "nextPage": {
          "type": [
            "string",
            "null"
          ]
        },
        "query": {
          "type": "string"
        }
      },
      "required": [
        "query",
        "hits",
        "nextPage",
        "coverage"
      ],
      "type": "object"
    },
    "SearchThreadsOutput": {
      "properties": {
        "coverage": {
          "$ref": "#/$defs/CoverageRow"
        },
        "nextPage": {
          "type": [
            "string",
            "null"
          ]
        },
        "query": {
          "type": "string"
        },
        "threads": {
          "items": {
            "$ref": "#/$defs/ThreadRow"
          },
          "type": "array"
        }
      },
      "required": [
        "query",
        "threads",
        "nextPage",
        "coverage"
      ],
      "type": "object"
    },
    "TemporalRow": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "full",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "filling": {
              "type": "boolean"
            },
            "kind": {
              "const": "bounded",
              "type": "string"
            },
            "since": {
              "type": [
                "string",
                "null"
              ]
            },
            "until": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "since",
            "until",
            "filling"
          ],
          "type": "object"
        }
      ]
    },
    "ThreadRow": {
      "properties": {
        "account": {
          "type": [
            "string",
            "null"
          ]
        },
        "count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "first": {
          "type": [
            "string",
            "null"
          ]
        },
        "hits": {
          "items": {
            "$ref": "#/$defs/HitRow"
          },
          "type": "array"
        },
        "last": {
          "type": [
            "string",
            "null"
          ]
        },
        "thread": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "account",
        "thread",
        "count",
        "first",
        "last",
        "hits"
      ],
      "type": "object"
    },
    "UnreadRow": {
      "properties": {
        "bodiless": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "encrypted": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "missing": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "unparseable": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "bodiless",
        "missing",
        "unparseable",
        "encrypted"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/SearchOutput"
    },
    {
      "$ref": "#/$defs/SearchThreadsOutput"
    }
  ],
  "title": "OneOf"
}
